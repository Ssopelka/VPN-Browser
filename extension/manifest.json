{
  "manifest_version": 3,
  "name": "VPN Terminal",
  "version": "2.0.0",
  "description": "Весь трафик или только заблокированные в РФ ресурсы через VPN. Статистика трафика и замер скорости.",
  "key": "",
  "permissions": ["proxy", "storage", "nativeMessaging", "privacy", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "VPN Terminal",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  }
}
